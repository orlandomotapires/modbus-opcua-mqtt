# Copie para .env:  cp .env.example .env
# O Node-RED lê estas variáveis ao subir. Depois de editar: docker compose up -d --force-recreate nodered

# ---------- SIMULADOR (simulator/sim_clp.py rodando no Mac) ----------
CLP_HOST=host.docker.internal
OPCUA_ENDPOINT=opc.tcp://host.docker.internal:4840
MODBUS_PORT=502
MODBUS_UNIT_ID=1
NODEID_NUM1=ns=2;s=num1
NODEID_NUM2=ns=2;s=num2
RESULT_ADDR=0
# 1 = CLP envia a palavra baixa do Float32 primeiro (word swap)
RESULT_WORD_SWAP=0

# ---------- CLP REAL (MasterTool) - descomente e comente o bloco acima ----------
# Linhas marcadas com _placeholder ainda precisam do valor confirmado no MasterTool.
# CLP_HOST=192.168.15.1
# porta_opcua_placeholder (4840 é o padrão)
# OPCUA_ENDPOINT=opc.tcp://192.168.15.1:4840
# MODBUS_PORT=502
# unitid_placeholder
# MODBUS_UNIT_ID=1
# NODEID_NUM1=ns=4;s=|var|CLP_placeholder.Application.GVL.num1_placeholder
# NODEID_NUM2=ns=4;s=|var|CLP_placeholder.Application.GVL.num2_placeholder
# resultado_endereco_placeholder (registrador do REAL no Modbus Server)
# RESULT_ADDR=0
# word_swap_placeholder (testar 0 ou 1 conforme o valor lido)
# RESULT_WORD_SWAP=0
