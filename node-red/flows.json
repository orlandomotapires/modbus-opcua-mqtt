    {
        "id": "func_prepara_opcua",
        "type": "function",
        "z": "tab_arquitetura_clp",
        "name": "Junta num1 + num2 (Int16)",
        "func": "// O botão \"Enviar ao CLP\" publica mobile/numero1 e depois mobile/numero2 (mesma conexão,\n// ordem garantida pelo MQTT). numero1 abre o par, numero2 fecha; os dois vão ao CLP\n// numa única requisição OPC-UA. Nada é escrito se faltar um dos números.\nconst JANELA_MS = 1500;\nconst valor = Number(msg.payload);\nif (!Number.isFinite(valor)) {\n    node.warn(`Valor inválido em ${msg.topic}: ${msg.payload}`);\n    context.set('num1', null);\n    return null;\n}\n// Tipo fixado em Int16 (INT no CLP) para evitar BadTypeMismatch\nconst int16 = Math.max(-32768, Math.min(32767, Math.trunc(valor)));\n\nif (msg.topic === 'mobile/numero1') {\n    context.set('num1', { valor: int16, t: Date.now() });\n    node.status({ fill: 'yellow', shape: 'ring', text: `num1=${int16}, aguardando num2` });\n    return null;\n}\nif (msg.topic !== 'mobile/numero2') return null;\n\nconst num1 = context.get('num1');\ncontext.set('num1', null);\nif (!num1 || Date.now() - num1.t > JANELA_MS) {\n    node.warn('numero2 chegou sem numero1 — envie os dois pelo botão do app');\n    node.status({ fill: 'red', shape: 'ring', text: 'faltou num1' });\n    return null;\n}\n\nflow.set('num1', num1.valor);\nflow.set('num2', int16);\nnode.status({ fill: 'green', shape: 'dot', text: `num1=${num1.valor} num2=${int16}` });\nreturn {\n    topic: 'num1_num2',\n    payload: [\n        { nodeId: env.get('NODEID_NUM1'), datatype: 'Int16', value: num1.valor },\n        { nodeId: env.get('NODEID_NUM2'), datatype: 'Int16', value: int16 },\n    ],\n};\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 130,
        "wires": [
            [
                "opcua_write_clp",
                "debug_ida"
            ]
        ]
    },
