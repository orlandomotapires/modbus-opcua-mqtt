    {
        "id": "func_float32",
        "type": "function",
        "z": "tab_arquitetura_clp",
        "name": "Registradores -> Float32",
        "func": "// 2 holding registers -> Float32 (REAL no CLP)\nconst regs = msg.payload;\nif (!Array.isArray(regs) || regs.length < 2) return null;\n\nconst swap = env.get('RESULT_WORD_SWAP') === '1';\nconst [hi, lo] = swap ? [regs[1], regs[0]] : [regs[0], regs[1]];\n\nconst buf = Buffer.alloc(4);\nbuf.writeUInt16BE(hi & 0xFFFF, 0);\nbuf.writeUInt16BE(lo & 0xFFFF, 2);\nconst valor = buf.readFloatBE(0);\n\n// NaN = divisão por zero no CLP/simulador\nmsg.payload = Number.isNaN(valor) ? 'NaN' : Number(valor.toPrecision(7));\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 300,
